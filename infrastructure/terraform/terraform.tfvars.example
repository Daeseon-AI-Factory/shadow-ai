# terraform.tfvars.example — copy to terraform.tfvars and fill in. terraform.tfvars is GITIGNORED
# because it holds secrets. Most values have sensible defaults in variables.tf; you usually only
# need the secrets below.

# --- Required: the AI key the analysis pipeline uses (default provider = gemini, free tier) -----
gemini_api_key = "AIza...your-google-gemini-key..."

# --- Optional ----------------------------------------------------------------------------------
# Only if you switch ai_provider to "claude":
# anthropic_api_key = "sk-ant-..."

# Once you wire up RevenueCat (PAY-2/PAY-4): REVENUECAT_API_KEY, REVENUECAT_WEBHOOK_AUTH_VALUE,
# REVENUECAT_WEBHOOK_HMAC_SECRET. Not yet provisioned here — add alongside real RevenueCat
# project credentials (docs/MONETIZATION-DESIGN.md §16). The old billing_webhook_secret variable
# (generic payment-agnostic webhook) was removed when that endpoint was retired.

# --- Overrides (optional — everything has a default) -------------------------------------------
# project              = "tubeshadow"
# aws_region           = "ca-central-1"
# api_domain           = "api.mimi.daeseon.ai"
# github_repo          = "Daeseon-AI-Factory/shadow-ai"
# github_branch        = "main"
# db_instance_class    = "db.t4g.micro"
# desired_count        = 1

# Groq API key (free tier) — Whisper speech-to-text for the interview mic.
# Get one free at https://console.groq.com → API Keys. Empty = transcription off.
groq_api_key = ""
